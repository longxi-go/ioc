package main

import (
	"context"
	"testing"

	app "github.com/longxi-go/ioc/pkg/context"
)

func TestConditionalDefinitions(t *testing.T) {
	ctx := context.Background()
	a, err := app.NewApplicationContext(context.Background(), app.WithPlan("example.org/app"))
	if err != nil {
		t.Fatal(err)
	}
	if err := a.Start(ctx); err != nil {
		t.Fatal(err)
	}
	defer func() {
		if err := a.Close(ctx); err != nil {
			t.Error(err)
		}
	}()
	accepted := map[string]bool{}
	for _, definition := range a.Definitions() {
		accepted[definition.Name] = true
	}
	for _, name := range []string{"IndependentRequirements", "BothMissing", "NameOnly", "InferredPresent", "OnlyDefault", "NeedsFactory", "GenericAliasWorks", "PhantomInstanceWorks"} {
		if !accepted[name] {
			t.Errorf("missing accepted Bean %s", name)
		}
	}
	for _, name := range []string{"RepeatedAnd", "MissingTypePresent", "MissingNamePresent", "Fallback"} {
		if accepted[name] {
			t.Errorf("unexpected accepted Bean %s", name)
		}
	}
}
