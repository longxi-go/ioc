package main

import (
	"context"
	"errors"
)

var constructorFailure = errors.New("constructor failed")

var initialized, destroyed int

type Resource struct{}

func (*Resource) Init(context.Context) error {
	initialized++
	return nil
}

func (r *Resource) Destroy(context.Context) error {
	if r == nil {
		panic("nil object must not transfer cleanup ownership")
	}
	destroyed++
	return nil
}

// +ioc:bean
// +ioc:lazy
func NilResource() *Resource {
	return nil
}

// +ioc:bean
// +ioc:lazy
func FailedNilResource() (*Resource, error) {
	return nil, constructorFailure
}

// +ioc:bean
// +ioc:lazy
func ValidResource() *Resource {
	return &Resource{}
}

// +ioc:bean
func ZeroValue() int {
	return 0
}

// +ioc:bean
func NilMap() map[string]int {
	return nil
}

func main() {
}
