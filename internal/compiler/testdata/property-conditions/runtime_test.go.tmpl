package main

import (
	"context"
	"slices"
	"strings"
	"testing"

	app "github.com/longxi-go/ioc/pkg/context"
)

func TestExactPropertyConditions(t *testing.T) {
	for _, tc := range []struct {
		name       string
		properties map[string]string
		want       []string
	}{
		{
			name: "absent keys",
		},
		{
			name: "exact values",
			properties: map[string]string{
				"storage": "memory",
				"empty":   "",
				"value":   "a=b",
				"enabled": "false",
			},
			want: []string{"Disabled", "Empty", "EqualityInValue", "Memory"},
		},
		{
			name: "no normalization or boolean conversion",
			properties: map[string]string{
				"storage": "Memory",
				"empty":   " ",
				"value":   "a",
				"enabled": "0",
			},
		},
	} {
		t.Run(tc.name, func(t *testing.T) {
			ctx := context.Background()
			a, err := app.NewApplicationContext(context.Background(), app.WithPlan("example.org/app"), app.WithProperties(tc.properties))
			if err != nil {
				t.Fatal(err)
			}
			t.Cleanup(func() {
				if err := a.Close(ctx); err != nil {
					t.Error(err)
				}
			})
			if err := a.Start(ctx); err != nil {
				t.Fatal(err)
			}
			var active []string
			for _, definition := range a.Definitions() {
				if strings.HasPrefix(definition.ID, "example.org/app.") {
					active = append(active, definition.Name)
				}
			}
			slices.Sort(active)
			if !slices.Equal(active, tc.want) {
				t.Fatalf("active Beans %v; want %v", active, tc.want)
			}
		})
	}
}
